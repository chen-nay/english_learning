    "senses": [
      {
        "meaning": "稳步地；持续而有规律地",
        "grammar": "adv.",
        "definition": "在一段时间内以相对稳定的方式逐渐发展或变化。",
        "phrases": [
          {
            "en": "grow steadily",
            "cn": "稳步增长"
          },
          {
            "en": "decline steadily",
            "cn": "持续下降"
          },
          {
            "en": "improve steadily",
            "cn": "稳步改善"
          }
        ],
        "sentence": {
          "en": "Response times have improved steadily over the past month.",
          "cn": "过去一个月，响应时间一直在稳步改善。"
        },
        "synonyms": [
          {
            "en": "consistently",
            "cn": "持续一致地"
          },
          {
            "en": "gradually",
            "cn": "逐渐地"
          }
        ],
        "antonyms": [
