            "cn": "平稳地呼吸"
          },
          {
            "en": "look steadily at someone",
            "cn": "目光稳定地看着某人"
          }
        ],
        "sentence": {
          "en": "She breathed steadily before beginning the presentation.",
          "cn": "开始演示前，她平稳地呼吸。"
        },
        "synonyms": [
          {
            "en": "calmly",
            "cn": "平静地"
          },
          {
            "en": "evenly",
            "cn": "均匀地"
          }
        ],
        "antonyms": [
          {
            "en": "unsteadily",
            "cn": "不稳地"
          }
