  {
    "word": "elevate",
    "phoneticUs": "/ˈel.ə.veɪt/",
    "pos": "v.",
    "summary": "提升；提高；抬高",
    "note": "较正式的用词，可以指实际抬高，也可以指提升质量、地位或重要性。elevated 也可表示升高的状态。",
    "senses": [
      {
        "meaning": "提升；提高",
        "grammar": "v. [T]",
        "definition": "使质量、地位或重要性达到更高水平。",
        "phrases": [
          {
            "en": "elevate the quality",
            "cn": "提升质量"
          },
          {
            "en": "elevate someone to a position",
            "cn": "把某人提升到某个职位"
          },
          {
            "en": "elevate the discussion",
            "cn": "提升讨论的层次"
          }
        ],
        "sentence": {
          "en": "Clear documentation can elevate the quality of a project.",
          "cn": "清晰的文档可以提升项目质量。"
        },
        "synonyms": [
          {
            "en": "improve",
            "cn": "改善；提高"
          },
          {
            "en": "raise",
            "cn": "提高"
          }
        ],
        "antonyms": [
          {
            "en": "lower",
            "cn": "降低"
          },
          {
            "en": "diminish",
            "cn": "削弱；降低"
          }
        ],
        "synonymNote": "improve 主要指改善；raise 适用范围更广，具体宾语搭配不完全相同。",
        "antonymNote": "lower 侧重降低水平；diminish 侧重减弱重要性、程度等。"
      },
      {
        "meaning": "抬高；举起",
        "grammar": "v. [T]",
        "definition": "把物体从较低位置移到较高位置。",
        "phrases": [
          {
            "en": "elevate a platform",
            "cn": "升高平台"
          },
          {
            "en": "elevate the screen",
            "cn": "抬高屏幕"
          }
        ],
        "sentence": {
          "en": "The adjustable stand allows you to elevate the screen.",
          "cn": "这个可调节支架可以让你抬高屏幕。"
        },
        "synonyms": [
          {
            "en": "raise",
            "cn": "抬高"
          },
          {
            "en": "lift",
            "cn": "举起"
          }
        ],
        "antonyms": [
          {
            "en": "lower",
            "cn": "放低"
          }
        ],
        "synonymNote": "",
        "antonymNote": ""
      }
    ],
    "sources": [
      {
        "label": "Cambridge",
        "url": "https://dictionary.cambridge.org/dictionary/english/elevate"
      }
    ]
