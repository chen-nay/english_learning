        "antonyms": [],
        "synonymNote": "path 范围更广；track 也可指车辆或人畜形成的道路。",
        "antonymNote": "这个义项没有常用的直接反义词。"
      },
      {
        "meaning": "踪迹；一连串记录或线索",
        "grammar": "n. [C]",
        "definition": "某事物留下的连续痕迹，或能用于追踪活动、过程的信息。",
        "phrases": [
          {
            "en": "an audit trail",
            "cn": "审计追踪记录"
          },
          {
            "en": "a paper trail",
            "cn": "书面记录链"
          },
          {
            "en": "leave a trail",
            "cn": "留下踪迹"
          }
        ],
        "sentence": {
          "en": "The logs provide an audit trail of changes to user permissions.",
          "cn": "日志提供了用户权限变更的审计追踪记录。"
        },
        "synonyms": [
          {
            "en": "track",
            "cn": "踪迹"
          },
          {
            "en": "record",
            "cn": "记录"
          }
        ],
        "antonyms": [],
        "synonymNote": "record 只是记录，trail 更强调一系列痕迹或信息之间可追踪的联系。",
        "antonymNote": "没有通用的直接反义词；不要把删除记录当作这个名词的反义词。"
      },
      {
        "meaning": "落后于；跟在后面",
        "grammar": "v. [I/T]",
        "definition": "位置、进展或比赛成绩处在别人后面，也可表示跟随移动。",
        "phrases": [
          {
            "en": "trail behind competitors",
            "cn": "落后于竞争对手"
          },
          {
            "en": "trail by ten points",
            "cn": "落后十分"
          }
        ],
        "sentence": {
          "en": "The team was trailing by ten points at halftime.",
          "cn": "半场结束时，这支队伍落后十分。"
        },
        "synonyms": [
          {
            "en": "lag behind",
            "cn": "落后于"
          },
          {
            "en": "follow",
            "cn": "跟随"
          }
        ],
        "antonyms": [
          {
            "en": "lead",
            "cn": "领先"
          }
        ],
        "synonymNote": "lag behind 强调落后；follow 在跟随移动的语境中接近。",
        "antonymNote": "lead 主要在比赛、排名或位置先后的语境中与 trail 对照。"
      }
    ],
    "sources": [
      {
        "label": "Cambridge",
        "url": "https://dictionary.cambridge.org/dictionary/english/trail"
      }
    ]
