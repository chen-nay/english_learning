          }
        ],
        "synonymNote": "responsibility 还可指日常职责；censure 强调谴责，语气较正式。",
        "antonymNote": "credit 与 blame 是对好结果和坏结果进行归因时的对照，不能在所有句子中直接互换。"
      }
    ],
    "sources": [
      {
        "label": "Cambridge",
